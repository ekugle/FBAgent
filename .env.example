# ─── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Publer (handles Facebook publishing) ─────────────────────────────────────
# Generate in Publer → Settings → Access & Login → API Keys (Business plan required)
PUBLER_API_KEY=pub_live_...
# Find at: GET https://app.publer.com/api/v1/workspaces
PUBLER_WORKSPACE_ID=your_workspace_id
# Find at: GET https://app.publer.com/api/v1/accounts (pick the TX2Pay Facebook page)
PUBLER_FACEBOOK_ACCOUNT_ID=your_publer_account_id

# ─── Meta / Facebook (comments, analytics, and webhook only) ──────────────────
# Long-lived Page Access Token — used for reading comments and fetching insights.
# Get from: Meta Business Suite → Settings → Advanced → Page Access Token
# (no Facebook App setup required — a long-lived token from Graph API Explorer works)
FACEBOOK_PAGE_ACCESS_TOKEN=EAAxxxxxxxx...
# Your TX2Pay Facebook Page ID
FACEBOOK_PAGE_ID=1234567890
# Webhook verify token — any random string you choose
FACEBOOK_WEBHOOK_VERIFY_TOKEN=tx2pay_webhook_secret_2024

# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# ─── App ──────────────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
# Random 32+ char secret: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-here

# ─── Cron Security ────────────────────────────────────────────────────────────
# Bearer token for protecting /api/cron/* routes on Vercel
CRON_SECRET=your-cron-secret-here
