# ─── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Meta / Facebook ──────────────────────────────────────────────────────────
# Long-lived Page Access Token (never expires if generated correctly)
FACEBOOK_PAGE_ACCESS_TOKEN=EAAxxxxxxxx...
# Your Facebook App credentials (from developers.facebook.com)
FACEBOOK_APP_ID=1234567890
FACEBOOK_APP_SECRET=abcdef1234567890
# The Facebook Page ID for the TX2Pay business page
FACEBOOK_PAGE_ID=1234567890
# Webhook verify token — any random string you choose
FACEBOOK_WEBHOOK_VERIFY_TOKEN=tx2pay_webhook_secret_2024

# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# ─── App ──────────────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
# Random 32+ char secret: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-here

# ─── Cron Security ────────────────────────────────────────────────────────────
# Bearer token for protecting /api/cron/* routes on Vercel
CRON_SECRET=your-cron-secret-here
